#. Plugin Name of the plugin
#: kurvio-courier-connector-for-dalli.php
#: src/Admin/SystemStatus.php:54
msgid "Kurvio Courier Connector for Dalli"
msgstr "Интеграция доставки Dalli"

#. Plugin URI of the plugin
#: kurvio-courier-connector-for-dalli.php
msgid "https://github.com/sergei-vasilev-dev/courier-delivery-connector-for-dalli"
msgstr "https://github.com/sergei-vasilev-dev/courier-delivery-connector-for-dalli"

#. Description of the plugin
#: kurvio-courier-connector-for-dalli.php
msgid "Unofficial WooCommerce integration with the Dalli courier service: live shipping rates, pickup points, order creation, tracking and labels. Not affiliated with or endorsed by Dalli."
msgstr "Неофициальная интеграция WooCommerce с курьерской службой Dalli: расчёт доставки в реальном времени, пункты выдачи, создание заказов, отслеживание и наклейки. Не связана с Dalli и не одобрена Dalli."

#. Author of the plugin
#: kurvio-courier-connector-for-dalli.php
msgid "Sergey Vasilev"
msgstr "Sergey Vasilev"

#. Author URI of the plugin
#: kurvio-courier-connector-for-dalli.php
msgid "https://github.com/sergei-vasilev-dev"
msgstr "https://github.com/sergei-vasilev-dev"

