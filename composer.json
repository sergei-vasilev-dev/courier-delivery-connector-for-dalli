{
	"name": "sergei-vasilev-dev/kurvio-courier-connector-for-dalli",
	"description": "Unofficial WooCommerce integration with the Dalli courier service: live rates, pickup points, order creation, tracking and labels.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"keywords": ["woocommerce", "wordpress", "shipping", "dalli", "delivery"],
	"homepage": "https://github.com/sergei-vasilev-dev/courier-delivery-connector-for-dalli",
	"authors": [
		{
			"name": "Sergey Vasilev",
			"homepage": "https://github.com/sergei-vasilev-dev"
		}
	],
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"brain/monkey": "^2.6",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/woocommerce-stubs": "^11.2",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/extension-installer": "^1.3",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^10.5",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"woocommerce/woocommerce-sniffs": "^2.0",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"autoload-dev": {
		"psr-4": {
			"DalliDelivery\\Tests\\": "tests/"
		}
	},
	"config": {
		"platform": {
			"php": "8.1.0"
		},
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"stan": "phpstan analyse --memory-limit=1G",
		"test": "phpunit",
		"qa": [
			"@lint",
			"@stan",
			"@test"
		]
	}
}
